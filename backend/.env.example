# Copy to .env for local runs. On Railway, set these as service variables.

# Your Claude API key. On Railway you can reuse StreamScout's:
#   ANTHROPIC_API_KEY=${{StreamScout.ANTHROPIC_API_KEY}}   (use your StreamScout service's exact name)
ANTHROPIC_API_KEY=sk-ant-...

# Any long random string. The iOS app sends it so strangers can't use your server.
APP_TOKEN=change-me

# Where the learning memory is stored. On Railway, attach a Volume at /data.
DB_PATH=/data/rizzio.sqlite

# Optional: model override (default claude-haiku-5-5, the "Premium" engine)
# RIZZIO_MODEL=claude-opus-5-5
